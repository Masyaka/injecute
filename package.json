{
  "name": "injecute",
  "version": "0.18.0",
  "description": "Lightweight, type-safe, decorator-free dependency injection container for TypeScript",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Masyaka/injecute.git"
  },
  "homepage": "https://masyaka.github.io/injecute/",
  "bugs": {
    "url": "https://github.com/Masyaka/injecute/issues"
  },
  "license": "MIT",
  "author": "Masyaka",
  "keywords": [
    "di",
    "dic",
    "dependency",
    "injection",
    "container",
    "typesafe",
    "ioc",
    "inversion",
    "of",
    "control",
    "functional",
    "fp"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rm -rf ./lib",
    "build": "npm run clean && tsc -p ./tsconfig.build.json",
    "typecheck": "tsc -p ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run check:versions",
    "changeset": "changeset",
    "docs:build": "vite build docs/ --base ./",
    "docs:dev": "vite docs/",
    "prepack": "npm run build",
    "check:versions": "node scripts/sync-jsr-version.mjs --check",
    "check:jsr": "deno publish --dry-run --allow-dirty",
    "version-packages": "changeset version && node scripts/sync-jsr-version.mjs && prettier --write CHANGELOG.md jsr.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "test:smoke": "node tests/smoke/run.mjs",
    "test:types-consumer": "node tests/types-consumer/run.mjs",
    "test:browser": "playwright test -c tests/browser/playwright.config.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "d3": "^7.9.0",
    "eslint": "^10.11.0",
    "monaco-editor": "^0.52.2",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
